<UserControl x:Class="Workbench.Desktop.FormActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The bottom of an edit form: the save error, then Save and Cancel. DataContext: the page's RecordPage. -->
    <StackPanel Margin="0,4,0,0">
        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Margin="0,14,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolVis}}" />
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Content="{Binding SaveLabel}" MinWidth="88" />
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Content="Cancel" Margin="10,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
