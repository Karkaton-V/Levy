<Window x:Class="Workbench.Desktop.EditProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Workbench.Desktop"
        Title="Edit profile" Width="860" Height="660" MinWidth="760" MinHeight="560"
        Background="{DynamicResource Ground}" Foreground="{DynamicResource Text}" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Edit your profile: name, pronouns, bio, banner and picture, with a live preview of your card. Styles: Assets/Settings/SettingsStyles.xaml. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource DialogBody}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <TextBlock x:Name="ErrorLine" Style="{StaticResource ErrorText}" Margin="0,0,0,12" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save" MinWidth="96" Click="Save" IsDefault="True" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="10,0,0,0" IsCancel="True" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Edit profile" Style="{StaticResource DialogTitle}" />
                        <TextBlock Text="This is what people you work with see when they open your card." Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />

                        <UniformGrid Columns="2" Margin="0,6,0,0">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Display name" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="NameBox" Style="{StaticResource Input}" MaxLength="80" TextChanged="Preview" AutomationProperties.Name="Display name" />
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Pronouns" Style="{StaticResource FormLabel}" />
                                <ComboBox x:Name="PronounsBox" Style="{StaticResource Select}" MinWidth="0" SelectionChanged="Preview" AutomationProperties.Name="Pronouns" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="About me" Style="{StaticResource FormLabel}" />
                        <TextBox x:Name="BioBox" Style="{StaticResource TextArea}" MaxLength="300" MinHeight="96" Tag="A line or two about your work" TextChanged="Preview"
                                 AutomationProperties.Name="About me" />
                        <TextBlock x:Name="BioCount" Style="{StaticResource CharCount}" />

                        <TextBlock Text="Profile picture" Style="{StaticResource FormLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="Upload picture…" Click="PickAvatar" />
                            <Button x:Name="RemoveAvatarButton" Style="{StaticResource LinkButton}" Content="Remove" Margin="14,0,0,0" VerticalAlignment="Center" Click="RemoveAvatar" />
                        </StackPanel>
                        <TextBlock Text="PNG or JPEG. Cropped to a square around the middle." Style="{StaticResource FormNote}" />

                        <TextBlock Text="Banner" Style="{StaticResource FormLabel}" />
                        <StackPanel x:Name="Swatches" Orientation="Horizontal" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="Upload banner…" Click="PickBanner" />
                            <Button x:Name="RemoveBannerButton" Style="{StaticResource LinkButton}" Content="Use the colour" Margin="14,0,0,0" VerticalAlignment="Center" Click="RemoveBanner" />
                        </StackPanel>
                        <TextBlock Text="An image covers the colour. Cropped to a wide 3:1 band." Style="{StaticResource FormNote}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Live preview. -->
        <StackPanel Grid.Column="1" Margin="12,24,24,24">
            <TextBlock Text="PREVIEW" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
            <local:ProfileCardView x:Name="PreviewCard" />
        </StackPanel>
    </Grid>
</Window>
