<UserControl x:Class="Workbench.Desktop.EditProfileDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Workbench.Desktop"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             Width="860" MaxHeight="680" FontSize="13" Foreground="{DynamicResource Text}">
    <!-- Edit your profile, shown inside the main window: name, pronouns, bio, picture, profile colour, banner and code colours, with a live preview of your card.
         Styles: Assets/App/AppStyles.xaml (the dialog card) and Assets/Settings/SettingsStyles.xaml. -->
    <Border Style="{StaticResource DialogCard}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource DialogBody}" CornerRadius="11,0,0,11">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <TextBlock x:Name="ErrorLine" Style="{StaticResource ErrorText}" Margin="0,0,0,12" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save" MinWidth="96" Click="Save" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="10,0,0,0" Click="Cancel" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Edit profile" Style="{StaticResource DialogTitle}" />
                            <TextBlock Text="This is what people you work with see when they open your card." Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />

                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Display name" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="NameBox" Style="{StaticResource Input}" MaxLength="80" TextChanged="Preview" AutomationProperties.Name="Display name" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Pronouns" Style="{StaticResource FormLabel}" />
                                    <ComboBox x:Name="PronounsBox" Style="{StaticResource Select}" MinWidth="0" Tag="Choose…" SelectionChanged="Preview" AutomationProperties.Name="Pronouns" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="About me" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="BioBox" Style="{StaticResource TextArea}" MaxLength="300" MinHeight="96" Tag="A line or two about your work" TextChanged="Preview"
                                     AutomationProperties.Name="About me" />
                            <TextBlock x:Name="BioCount" Style="{StaticResource CharCount}" />

                            <TextBlock Text="Profile picture" Style="{StaticResource FormLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Content="Upload picture…" Click="PickAvatar" />
                                <Button x:Name="AdjustAvatarButton" Style="{StaticResource LinkButton}" Content="Adjust" Margin="14,0,0,0" VerticalAlignment="Center" Click="AdjustAvatar" />
                                <Button x:Name="RemoveAvatarButton" Style="{StaticResource LinkButton}" Content="Remove" Margin="14,0,0,0" VerticalAlignment="Center" Click="RemoveAvatar" />
                            </StackPanel>
                            <TextBlock Text="PNG or JPEG. You choose the part to show after picking it." Style="{StaticResource FormNote}" />

                            <TextBlock Text="Profile color" Style="{StaticResource FormLabel}" />
                            <StackPanel x:Name="Swatches" Orientation="Horizontal" />
                            <TextBlock Text="Colours your buttons, links and highlights, tints the background, and fills your banner when it has no image." Style="{StaticResource FormNote}" />

                            <TextBlock Text="Banner image" Style="{StaticResource FormLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Content="Upload banner…" Click="PickBanner" />
                                <Button x:Name="AdjustBannerButton" Style="{StaticResource LinkButton}" Content="Adjust" Margin="14,0,0,0" VerticalAlignment="Center" Click="AdjustBanner" />
                                <Button x:Name="RemoveBannerButton" Style="{StaticResource LinkButton}" Content="Use the colour" Margin="14,0,0,0" VerticalAlignment="Center" Click="RemoveBanner" />
                            </StackPanel>
                            <TextBlock Text="An image covers the colour. You choose the part to show after picking it." Style="{StaticResource FormNote}" />

                            <!-- Code colours: the rules editor's scheme, separate from the profile colour. -->
                            <TextBlock Text="Code colors" Style="{StaticResource FormLabel}" />
                            <ComboBox x:Name="CodeThemeBox" Style="{StaticResource Select}" DisplayMemberPath="Name" SelectionChanged="CodeThemeChanged" AutomationProperties.Name="Code colors" />
                            <Border Style="{StaticResource CodeSample}">
                                <avalon:TextEditor x:Name="CodeSample" FontFamily="{StaticResource Mono}" FontSize="13" IsReadOnly="True" ShowLineNumbers="True"
                                                   HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Padding="0,8" Focusable="False" />
                            </Border>
                            <TextBlock Text="Only changes how the rules editor looks for you." Style="{StaticResource FormNote}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Adjusting a picture or banner: takes over the form until Apply or Back; the preview follows the frame. -->
            <Border x:Name="CropPanel" Style="{StaticResource DialogBody}" CornerRadius="11,0,0,11" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="CropTitle" Style="{StaticResource DialogTitle}" />
                        <TextBlock Text="Drag the frame to move it. Drag a corner or scroll to resize. Arrow keys and + / − work too." Foreground="{DynamicResource Muted}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Apply" MinWidth="96" Click="ApplyCrop" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Back" Margin="10,0,0,0" Click="CancelCrop" />
                    </StackPanel>
                    <local:ImageCropper x:Name="Cropper" />
                </DockPanel>
            </Border>

            <!-- Live preview, and the close button in the corner. -->
            <StackPanel Grid.Column="1" Margin="12,24,24,24">
                <TextBlock Text="PREVIEW" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                <local:ProfileCardView x:Name="PreviewCard" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="{StaticResource CloseGlyph}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,12,0" Click="Cancel" ToolTip="Close (Esc)" AutomationProperties.Name="Close" />
        </Grid>
    </Border>
</UserControl>
