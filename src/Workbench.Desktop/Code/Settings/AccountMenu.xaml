<UserControl x:Class="Workbench.Desktop.AccountMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Rail footer: the signed-in user and a gear that opens the settings menu upward. Styles: Assets/App/AppStyles.xaml. -->
    <Border x:Name="Footer" Style="{StaticResource RailFooter}">
        <DockPanel>
            <ToggleButton x:Name="Gear" DockPanel.Dock="Right" Style="{StaticResource RailIconToggle}" Content="{StaticResource SettingsGlyph}"
                          ToolTip="Settings" AutomationProperties.Name="Settings" VerticalAlignment="Center"
                          IsChecked="{Binding IsOpen, ElementName=Menu, Mode=TwoWay}" />
            <Border Style="{StaticResource Avatar}" VerticalAlignment="Center">
                <TextBlock x:Name="FooterInitials" Style="{StaticResource AvatarText}" />
            </Border>
            <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="FooterName" Foreground="{DynamicResource NavStrong}" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FooterEmail" Foreground="{DynamicResource NavMuted}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Popup x:Name="Menu" PlacementTarget="{Binding ElementName=Footer}" Placement="Top" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Slide" Focusable="False">
                <Border Style="{StaticResource MenuCard}">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource Avatar}" Width="38" Height="38" CornerRadius="19">
                                <TextBlock x:Name="MenuInitials" Style="{StaticResource AvatarText}" FontSize="14" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MenuName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MenuEmail" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource MenuDivider}" />

                        <TextBlock Text="Appearance" Style="{StaticResource FormLabel}" />
                        <Border Style="{StaticResource SegmentTrackBorder}" HorizontalAlignment="Stretch" Margin="0,6,0,0">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="LightOption" GroupName="Theme" Content="Light" Style="{StaticResource SegmentButton}" Checked="ThemeChosen" />
                                <RadioButton x:Name="DarkOption" GroupName="Theme" Content="Dark" Style="{StaticResource SegmentButton}" Checked="ThemeChosen" Margin="4,0,0,0" />
                            </UniformGrid>
                        </Border>

                        <StackPanel x:Name="SignOutSection">
                            <Border Style="{StaticResource MenuDivider}" />
                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="SignOutClicked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource SignOutGlyph}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="Sign out" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </DockPanel>
    </Border>
</UserControl>
