<UserControl x:Class="Workbench.Desktop.AccountMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Workbench.Desktop">
    <!-- Rail footer: your name and picture (opens your profile card) and a gear (opens the settings menu). Both rise from behind the footer;
         opening one closes the other. Styles: Assets/App/AppStyles.xaml and Assets/Settings/SettingsStyles.xaml. -->
    <Border x:Name="Footer" Style="{StaticResource RailFooter}">
        <DockPanel>
            <ToggleButton x:Name="Gear" DockPanel.Dock="Right" Style="{StaticResource RailIconToggle}" Click="GearClicked"
                          ToolTip="Settings" AutomationProperties.Name="Settings" VerticalAlignment="Center">
                <TextBlock Text="{StaticResource SettingsGlyph}" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="GearSpin" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </ToggleButton>

            <ToggleButton x:Name="ProfileButton" Style="{StaticResource RailProfileToggle}" Click="ProfileClicked" Margin="0,0,6,0"
                          ToolTip="Your profile" AutomationProperties.Name="Your profile">
                <DockPanel>
                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                        <Border Style="{StaticResource Avatar}">
                            <TextBlock x:Name="FooterInitials" Style="{StaticResource AvatarText}" />
                        </Border>
                        <Ellipse x:Name="FooterPicture" Width="32" Height="32" />
                    </Grid>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FooterName" Foreground="{DynamicResource NavStrong}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="FooterEmail" Foreground="{DynamicResource NavMuted}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </ToggleButton>

            <!-- Settings menu. The popup's bottom edge sits on the footer's top edge and clips, so the card seems to rise from behind it. -->
            <Popup x:Name="Menu" PlacementTarget="{Binding ElementName=Footer}" Placement="Top" StaysOpen="True" AllowsTransparency="True" Focusable="False">
                <Border ClipToBounds="True" Background="Transparent" Width="{Binding ActualWidth, ElementName=Footer}">
                    <Border x:Name="Card" Style="{StaticResource MenuCard}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="CardSlide" />
                        </Border.RenderTransform>
                        <StackPanel>
                            <DockPanel>
                                <Grid Width="38" Height="38">
                                    <Border Style="{StaticResource Avatar}" Width="38" Height="38" CornerRadius="19">
                                        <TextBlock x:Name="MenuInitials" Style="{StaticResource AvatarText}" FontSize="14" />
                                    </Border>
                                    <Ellipse x:Name="MenuPicture" Width="38" Height="38" />
                                </Grid>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="MenuName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="MenuEmail" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <Button x:Name="EditProfileButton" Style="{StaticResource MenuRowButton}" Click="EditProfileClicked" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource EditGlyph}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="Edit profile" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Border Style="{StaticResource MenuDivider}" />

                            <TextBlock Text="Appearance" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource SegmentTrackBorder}" HorizontalAlignment="Stretch">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="LightOption" GroupName="Theme" Content="Light" Style="{StaticResource SegmentButton}" Checked="ThemeChosen" />
                                    <RadioButton x:Name="DarkOption" GroupName="Theme" Content="Dark" Style="{StaticResource SegmentButton}" Checked="ThemeChosen" Margin="4,0,0,0" />
                                </UniformGrid>
                            </Border>
                            <CheckBox x:Name="ReduceMotionOption" Content="Reduce motion" Foreground="{DynamicResource Text}" Margin="2,12,0,0" Cursor="Hand"
                                      Click="ReduceMotionClicked" ToolTip="Open and close menus without animation" />

                            <Border Style="{StaticResource MenuDivider}" />

                            <TextBlock Text="Account" Style="{StaticResource FormLabel}" Margin="0,0,0,2" />
                            <Button x:Name="PasswordButton" Style="{StaticResource MenuRowButton}" Click="ChangePasswordClicked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource PasswordGlyph}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="Change password" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <StackPanel x:Name="SignOutSection">
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="SignOutClicked" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{StaticResource SignOutGlyph}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="Sign out" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource LinkButton}" Content="Sign out of all devices" HorizontalAlignment="Center" Margin="0,10,0,0"
                                        Click="SignOutEverywhereClicked" ToolTip="Ends your sessions on every computer, including this one" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Popup>

            <!-- Profile card. Wider than the side panel, like Discord's; it grows to the right over the page. -->
            <Popup x:Name="ProfilePopup" PlacementTarget="{Binding ElementName=Footer}" Placement="Top" StaysOpen="True" AllowsTransparency="True" Focusable="False">
                <Border ClipToBounds="True" Background="Transparent" Width="336">
                    <Grid x:Name="ProfileHost" Margin="12,12,12,8">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ProfileSlide" />
                        </Grid.RenderTransform>
                        <Grid.Effect>
                            <DropShadowEffect Color="{DynamicResource MenuShadowColor}" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.28" />
                        </Grid.Effect>
                        <local:ProfileCardView x:Name="ProfileView" />
                        <Button Style="{StaticResource BannerButton}" Click="EditProfileClicked" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                ToolTip="Edit profile" AutomationProperties.Name="Edit profile">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource EditGlyph}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="Edit" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Popup>
        </DockPanel>
    </Border>
</UserControl>
