<Window x:Class="Workbench.Desktop.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change password" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Set a new password for the signed-in account. Styles: Assets/Settings/SettingsStyles.xaml. -->
    <Border Style="{StaticResource DialogBody}">
        <StackPanel>
            <TextBlock Text="Change password" Style="{StaticResource DialogTitle}" />
            <TextBlock Text="Use at least 8 characters. Other devices stay signed in; use Sign out of all devices to end them too." Foreground="{DynamicResource Muted}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="New password" Style="{StaticResource FormLabel}" />
            <PasswordBox x:Name="NewBox" Style="{StaticResource PasswordInput}" AutomationProperties.Name="New password" />
            <TextBlock Text="Type it again" Style="{StaticResource FormLabel}" />
            <PasswordBox x:Name="RepeatBox" Style="{StaticResource PasswordInput}" AutomationProperties.Name="Repeat new password" />
            <TextBlock x:Name="ErrorLine" Style="{StaticResource ErrorText}" Margin="0,14,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Change password" Click="Save" IsDefault="True" />
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="10,0,0,0" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
