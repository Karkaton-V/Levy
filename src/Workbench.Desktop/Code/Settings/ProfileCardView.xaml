<UserControl x:Class="Workbench.Desktop.ProfileCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A profile card: banner, picture, name, pronouns and job title, email, bio and badges. DataContext: ProfileCard. Styles: Assets/Settings/SettingsStyles.xaml. -->
    <Border x:Name="Shell" Style="{StaticResource ProfileCardShell}">
        <StackPanel>
            <Grid>
                <!-- The banner: an image or a colour, drawn by the code so its top corners follow the card's. -->
                <Border x:Name="BannerFill" Height="100" CornerRadius="11,11,0,0" VerticalAlignment="Top" />
                <Border Style="{StaticResource ProfileRing}">
                    <Grid>
                        <Border Style="{StaticResource ProfileInitials}">
                            <TextBlock Text="{Binding Initials}" Style="{StaticResource ProfileInitialsText}" />
                        </Border>
                        <Ellipse x:Name="AvatarFill" Width="80" Height="80" Visibility="{Binding HasAvatar, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </Border>
                <Border Height="48" Margin="0,100,0,0" />
            </Grid>

            <StackPanel Margin="16,0,16,16">
                <TextBlock Text="{Binding Name}" Style="{StaticResource ProfileName}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource ProfileMuted}" FontSize="13" Foreground="{DynamicResource Soft}" />
                <TextBlock Text="{Binding Email}" Style="{StaticResource ProfileMuted}" />

                <Border Style="{StaticResource ProfileSection}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="ABOUT ME" Style="{StaticResource ProfileSectionTitle}" />
                        <TextBlock Text="{Binding Bio}" TextWrapping="Wrap" Foreground="{DynamicResource Text}" Visibility="{Binding HasBio, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="Nothing here yet." Foreground="{DynamicResource Muted}" Visibility="{Binding HasBio, Converter={StaticResource InverseBoolVis}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ProfileSection}">
                    <StackPanel>
                        <TextBlock Text="BADGES" Style="{StaticResource ProfileSectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Badges}" Focusable="False" Visibility="{Binding HasBadges, Converter={StaticResource BoolVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BadgePill}" ToolTip="{Binding Tip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource BadgeGlyph}" />
                                            <TextBlock Style="{StaticResource ChipText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No badges yet. Management awards them for great work." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                   Visibility="{Binding HasBadges, Converter={StaticResource InverseBoolVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
