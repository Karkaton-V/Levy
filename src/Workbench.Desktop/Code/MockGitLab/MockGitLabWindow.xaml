<Window x:Class="Workbench.Desktop.MockGitLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mock GitLab · demo" Width="1120" Height="740" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Ground}" Foreground="{DynamicResource Text}" FontSize="13" WindowStartupLocation="CenterOwner">
    <!-- A demo GitLab for trying the request workflow without a server: play developer and reviewer on issues Levy sent. DataContext: MockGitLabViewModel. Styles: Assets/MockGitLab/MockGitLabStyles.xaml. -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource MockTopBar}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mock GitLab" FontSize="18" FontWeight="SemiBold" />
                        <Border Style="{StaticResource DemoTag}">
                            <TextBlock Text="DEMO" Style="{StaticResource DemoTagText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource Muted}" Margin="0,3,0,0">
                        <Run Text="{Binding Host, Mode=OneWay}" /> <Run Text="· kept on this PC, nothing is sent anywhere" />
                    </TextBlock>
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Reset demo" Command="{Binding ResetCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0">
                    <TextBlock Text="Acting as" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                    <ComboBox Style="{StaticResource Select}" MinWidth="170" ItemsSource="{Binding People}" SelectedItem="{Binding ActingAs}" AutomationProperties.Name="Acting as" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right">
                    <TextBlock Text="Project" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                    <ComboBox Style="{StaticResource Select}" MinWidth="220" ItemsSource="{Binding Projects}" SelectedItem="{Binding Project}" AutomationProperties.Name="Project" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="24,20,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Issues, highest priority first: what developers pull from. -->
            <Border Style="{StaticResource TableCard}" Margin="0,0,20,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,14,18,12">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Counts}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource SegmentTrackBorder}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="IssueState" Content="Open" Style="{StaticResource SegmentButton}" IsChecked="{Binding ShowOpen}" />
                                <RadioButton GroupName="IssueState" Content="Closed" Style="{StaticResource SegmentButton}" IsChecked="{Binding ShowClosed}" Margin="4,0,0,0" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}" />
                    <ListBox Style="{StaticResource IssueList}" ItemContainerStyle="{StaticResource IssueItem}" ItemsSource="{Binding Issues}" SelectedItem="{Binding Selected}"
                             AutomationProperties.Name="Issues">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Labels}" ItemTemplate="{StaticResource ChipTemplate}" Margin="0,6,0,0" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Margin" Value="0,0,4,4" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- The selected issue and its merge request. -->
            <Border Grid.Column="1" Style="{StaticResource FormCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Pick an issue. Requests sent from Levy's Intake page appear here.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FormHint}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIssue}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- What the last action did, or why it couldn't: pinned under the panel so it shows wherever the panel is scrolled. -->
                    <Border Grid.Row="1" Style="{StaticResource MockMessage}" Margin="24,0,24,20" Visibility="{Binding HasMessage, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20" Visibility="{Binding HasIssue, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding IssueRef}" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource Mono}" FontSize="12" />
                            <TextBlock Text="{Binding Issue.Title}" Style="{StaticResource CardTitle}" FontSize="18" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Muted}">
                                <Run Text="{Binding Opened, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Assignee, Mode=OneWay}" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Selected.Labels}" ItemTemplate="{StaticResource ChipTemplate}" Margin="0,10,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,4,4" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource DetailText}" Margin="0,12,0,0" />

                            <!-- Developer: pick it up and start. -->
                            <WrapPanel Style="{StaticResource ActionRow}">
                                <Button Style="{StaticResource ActionButton}" Content="Assign to me" Command="{Binding AssignToMeCommand}" IsEnabled="{Binding IssueOpen}" />
                                <Button Style="{StaticResource ActionButton}" Content="Start work" Command="{Binding StartWorkCommand}" IsEnabled="{Binding IssueOpen}" />
                                <Button Style="{StaticResource PrimaryAction}" Content="Create merge request" Command="{Binding OpenMergeRequestCommand}" IsEnabled="{Binding CanOpenMergeRequest}" />
                                <Button Style="{StaticResource ActionButton}" Content="Close issue" Command="{Binding CloseIssueCommand}" Visibility="{Binding IssueOpen, Converter={StaticResource BoolVis}}" />
                                <Button Content="Reopen issue" Command="{Binding ReopenIssueCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IssueOpen}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>

                            <!-- Review: pipeline, ready, approval, merge. -->
                            <TextBlock Text="Merge request" Style="{StaticResource FormLabel}" Margin="0,18,0,0" />
                            <TextBlock Text="None yet. Create one to start the review.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FormNote}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMergeRequest}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Style="{StaticResource MergeRequestBox}" Visibility="{Binding HasMergeRequest, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding MergeRequest.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding MergeRequestRef}" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <ContentPresenter Content="{Binding MergeRequestState}" ContentTemplate="{StaticResource ChipTemplate}" Margin="0,0,6,0" />
                                        <ContentPresenter Content="{Binding PipelineState}" ContentTemplate="{StaticResource ChipTemplate}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Approvals}" Style="{StaticResource DetailText}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding MergeCheck}" Style="{StaticResource FormNote}" />
                                    <WrapPanel Style="{StaticResource ActionRow}" Visibility="{Binding MergeRequestOpen, Converter={StaticResource BoolVis}}">
                                        <Button Style="{StaticResource ActionButton}" Content="Push commit (run pipeline)" Command="{Binding RunPipelineCommand}" />
                                        <Button Style="{StaticResource ActionButton}" Content="Mark ready" Command="{Binding MarkReadyCommand}" IsEnabled="{Binding MergeRequest.Draft}" />
                                        <Button Style="{StaticResource ActionButton}" Content="Approve" Command="{Binding ApproveCommand}" />
                                        <Button Style="{StaticResource PrimaryAction}" Content="Merge" Command="{Binding MergeCommand}" IsEnabled="{Binding Mergeable}" />
                                        <Button Style="{StaticResource ActionButton}" Content="Close" Command="{Binding CloseMergeRequestCommand}" />
                                    </WrapPanel>
                                    <CheckBox Style="{StaticResource FormCheck}" Content="Next pipeline fails" IsChecked="{Binding FailNextPipeline}" Margin="0,4,0,0"
                                              Visibility="{Binding MergeRequestOpen, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource FormNote}" Margin="0,16,0,0"
                                       Text="Review rules: the pipeline must pass, drafts can't merge, new commits reset approvals, and authors can't approve their own merge request. Switch Acting as to play the reviewer." />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
