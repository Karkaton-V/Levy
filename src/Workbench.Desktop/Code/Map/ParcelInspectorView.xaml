<UserControl x:Class="Workbench.Desktop.ParcelInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Workbench.Desktop">
    <!-- Property record for the selected parcel; each step of "why this value" can open the code behind it. -->
    <StackPanel Margin="24,20,24,32">
        <TextBlock Text="{Binding SelectedTitle}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SelectedSubtitle}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0" />
        <Button Command="{Binding ZoomToSelectedCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Zoom to this parcel"
                HorizontalAlignment="Left" Margin="0,16,0,0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{StaticResource ZoomGlyph}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="Zoom" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <TextBlock Text="Market value" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,32,0,0" />
        <TextBlock Text="{Binding SelectedMarket}" FontFamily="{StaticResource Mono}" FontSize="30" Margin="0,4,0,0" />
        <TextBlock Text="{Binding SelectedSale}" Foreground="{DynamicResource Soft}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />

        <TextBlock Text="WHY THIS VALUE" Style="{StaticResource SectionLabel}" Margin="0,32,0,4" />
        <ItemsControl ItemsSource="{Binding Trace}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Rule}" Foreground="{DynamicResource Soft}" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center" />
                            <ToggleButton x:Name="InfoToggle" Grid.Column="1" Style="{StaticResource InfoToggle}" HorizontalAlignment="Left" Margin="8,0,0,0"
                                          ToolTip="Show the code behind this step" AutomationProperties.Name="{Binding Rule, StringFormat='Show the code behind {0}'}" />
                            <TextBlock Grid.Column="2" Text="{Binding Amount}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

                            <!-- Drop-down: the Editor lines that define this step, and how they combine. -->
                            <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource Ground}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    CornerRadius="6" Padding="14,12" Margin="0,12,0,0"
                                    Visibility="{Binding IsChecked, ElementName=InfoToggle, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding CodeCaption}" Foreground="{DynamicResource Muted}" FontSize="11" />
                                    <local:CodeSnippetView Code="{Binding Code}" Margin="0,6,0,0" Visibility="{Binding HasCode, Converter={StaticResource BoolVis}}" />
                                    <TextBlock Text="FORMULA" Style="{StaticResource SectionLabel}" Margin="0,14,0,4" />
                                    <TextBlock Text="{Binding Formula}" Foreground="{DynamicResource Soft}" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                                    <Button Content="Open in Editor" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                            Command="{Binding DataContext.OpenInEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding FirstLine}" Visibility="{Binding HasCode, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
