<UserControl x:Class="Workbench.Desktop.MapTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Workbench.Desktop">
    <!-- Map tab: the real map on the left, the selected parcel's record on the right. Styles: Assets/Map/MapStyles.xaml; map colours: Assets/Map/map-style.json. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="440" />
        </Grid.ColumnDefinitions>

        <!-- Map card: description, the map, and the legend underneath. -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="32,20,20,32" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="20,16,20,14">
                <TextBlock Text="Parcels" Style="{StaticResource CardTitle}" />
                <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0">
                    <Run Text="The border follows " /><Run Text="{Binding StudyAreaDescription, Mode=OneWay}" /><Run Text=". Every building inside it is a parcel; the coloured ones carry sample values. Hover to preview, click to open a record." />
                </TextBlock>
            </StackPanel>
            <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1">
                <local:ParcelMapView />
            </Border>

            <!-- Legend: one entry per look in map-style.json, so it always matches what the map draws. -->
            <ItemsControl x:Name="Legend" Grid.Row="2" Margin="20,14,20,8" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,6">
                            <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{Binding Fill}" BorderBrush="{Binding Outline}" BorderThickness="{Binding OutlineThickness}" />
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Soft}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        </Border>

        <!-- Sidebar: switch between the selected parcel's record and the rules that value it. -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="0,20,32,32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource SegmentTrack}" CornerRadius="8" Padding="3" Margin="24,20,24,0" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Sidebar" Content="Property record" Style="{StaticResource SegmentButton}" IsChecked="{Binding SidebarShowsRecord, Mode=TwoWay}" />
                        <RadioButton GroupName="Sidebar" Content="Rules" Style="{StaticResource SegmentButton}" IsChecked="{Binding SidebarShowsRules, Mode=TwoWay}" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding SidebarShowsRecord, Converter={StaticResource BoolVis}}">
                    <local:ParcelInspectorView />
                </ScrollViewer>

                <!-- Rules in plain words: a notepad-style, read-only description of what the Editor's code does. -->
                <Grid Grid.Row="1" Margin="24,20,24,24" Visibility="{Binding SidebarShowsRules, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Rules in plain words" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="What the Editor's code does. Read-only." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="Edit in Editor" Command="{Binding OpenInEditorCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" />
                    </DockPanel>
                    <TextBox Grid.Row="1" Margin="0,16,0,0" Text="{Binding RulesInWords, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Segoe UI" FontSize="14" Padding="20,18"
                             Background="{DynamicResource Ground}" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}"
                             BorderBrush="{DynamicResource Line}" BorderThickness="1" SelectionBrush="{DynamicResource Accent}"
                             AutomationProperties.Name="Rules in plain words" />
                    <TextBlock Grid.Row="2" Text="Edited in the Editor but not run yet · press F5 to apply" Foreground="{DynamicResource WarnText}" FontSize="12" Margin="0,12,0,0"
                               Visibility="{Binding IsStale, Converter={StaticResource BoolVis}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
