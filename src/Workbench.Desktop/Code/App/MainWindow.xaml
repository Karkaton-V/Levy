<Window x:Class="Workbench.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Workbench.Desktop"
        Title="Levy" Width="1332" Height="864" MinWidth="1180" MinHeight="720"
        Background="{DynamicResource Ground}" Foreground="{DynamicResource Text}" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <!-- The shell only: navigation rail, top bar and summary strip. Each page is its own view under Code/Editor, Code/Map and Code/Compare. Styles: Assets/App/AppStyles.xaml. -->

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail: brand, pages, and the account and settings menu at the bottom. -->
        <Border Grid.Column="0" Background="{DynamicResource NavBackground}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="24,24,20,32">
                    <ContentControl Style="{StaticResource LevyMark}" Height="34" HorizontalAlignment="Left" AutomationProperties.Name="Levy" />
                    <TextBlock Text="Mass appraisal" Foreground="{DynamicResource NavMuted}" FontSize="11" Margin="2,6,0,0" />
                </StackPanel>

                <local:AccountMenu x:Name="Account" DockPanel.Dock="Bottom" />

                <!-- Pages, under two headings; the headings are disabled items, so they can't be selected. Code-behind maps each item to its page by name. -->
                <ListBox x:Name="Nav" Style="{StaticResource NavList}" SelectionChanged="Nav_SelectionChanged" AutomationProperties.Name="Pages">
                    <ListBoxItem Style="{StaticResource NavHeading}" Content="VALUATION" Padding="28,0,0,8" />
                    <ListBoxItem x:Name="NavRules" Style="{StaticResource NavItem}" Tag="{StaticResource EditorGlyph}" Content="Rules" IsSelected="True" />
                    <ListBoxItem x:Name="NavMap" Style="{StaticResource NavItem}" Tag="{StaticResource MapGlyph}" Content="Parcel map" />
                    <ListBoxItem x:Name="NavCompare" Style="{StaticResource NavItem}" Tag="{StaticResource CompareGlyph}" Content="Compare runs" />
                    <ListBoxItem Style="{StaticResource NavHeading}" Content="WORKFLOW" />
                    <ListBoxItem x:Name="NavJobs" Style="{StaticResource NavItem}" Tag="{StaticResource JobsGlyph}" Content="Jobs" />
                    <ListBoxItem x:Name="NavProjects" Style="{StaticResource NavItem}" Tag="{StaticResource ProjectsGlyph}" Content="Projects" />
                    <ListBoxItem x:Name="NavBoard" Style="{StaticResource NavItem}" Tag="{StaticResource BoardGlyph}" Content="Scrum board" />
                    <ListBoxItem x:Name="NavTasks" Style="{StaticResource NavItem}" Tag="{StaticResource TasksGlyph}" Content="Tasks" />
                    <ListBoxItem x:Name="NavClients" Style="{StaticResource NavItem}" Tag="{StaticResource ClientsGlyph}" Content="Clients" />
                    <ListBoxItem x:Name="NavReports" Style="{StaticResource NavItem}" Tag="{StaticResource ReportsGlyph}" Content="Reports" />
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar: page title and subtitle (study area on valuation pages, organization on workflow pages), then last run and Run on valuation pages. -->
            <Border Grid.Row="0" Style="{StaticResource TopBar}">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedItem.Header, ElementName=Tabs}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PageSubtitle}" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsValuationPage, Converter={StaticResource BoolVis}}">
                        <Border Style="{StaticResource WarnPill}" Margin="0,0,16,0" Visibility="{Binding IsStale, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="● Not run" Foreground="{DynamicResource WarnStatus}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding StatusLine}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <Button Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                                ToolTip="Revalue every parcel with the current rules (F5)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource RunGlyph}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="Run model" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Summary strip: roll totals and the ratio study, on the valuation pages. -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Summary}" Margin="32,24,20,0" Focusable="False" Style="{StaticResource SummaryStrip}" ItemTemplate="{StaticResource SummaryCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Pages. The rail switches them by name; the workflow pages get the WorkspaceViewModel as DataContext from code-behind. -->
            <TabControl x:Name="Tabs" Grid.Row="2" Style="{StaticResource PageTabs}" SelectionChanged="Tabs_SelectionChanged">
                <TabItem x:Name="RulesPage" Header="Rules editor">
                    <local:EditorTabView x:Name="EditorTab" />
                </TabItem>
                <TabItem x:Name="MapPage" Header="Parcel map">
                    <local:MapTabView />
                </TabItem>
                <TabItem x:Name="ComparePage" Header="Compare runs">
                    <local:CompareTabView />
                </TabItem>
                <TabItem x:Name="JobsPage" Header="Jobs">
                    <local:JobsPageView x:Name="JobsView" />
                </TabItem>
                <TabItem x:Name="ProjectsPage" Header="Projects">
                    <local:ProjectsPageView x:Name="ProjectsView" />
                </TabItem>
                <TabItem x:Name="BoardPage" Header="Scrum board">
                    <local:BoardPageView x:Name="BoardView" />
                </TabItem>
                <TabItem x:Name="TasksPage" Header="Tasks">
                    <local:TasksPageView x:Name="TasksView" />
                </TabItem>
                <TabItem x:Name="ClientsPage" Header="Clients">
                    <local:ClientsPageView x:Name="ClientsView" />
                </TabItem>
                <TabItem x:Name="ReportsPage" Header="Reports">
                    <local:ReportsPageView x:Name="ReportsView" />
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
