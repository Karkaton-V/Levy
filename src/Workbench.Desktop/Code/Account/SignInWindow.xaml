<Window x:Class="Workbench.Desktop.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Levy · Sign in" Width="900" Height="580" MinWidth="760" MinHeight="540"
        Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}" FontSize="13"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <!-- Sign in or create an account. Styles: Assets/Account/AccountStyles.xaml. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Brand panel. -->
        <Border Grid.Column="0" Style="{StaticResource BrandPanel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Left">
                    <ContentControl Style="{StaticResource LevyMark}" Height="34" HorizontalAlignment="Left" AutomationProperties.Name="Levy" />
                    <TextBlock Text="Mass appraisal" Foreground="{DynamicResource NavMuted}" FontSize="11" Margin="2,6,0,0" />
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BrandHeadline}" Text="Values, appeals and the work around them, in one place." />
                    <StackPanel Margin="0,28,0,0">
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource BrandCheck}" />
                            <TextBlock Style="{StaticResource BrandText}" Text="Write valuation rules and see every parcel revalued on the map." />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource BrandCheck}" />
                            <TextBlock Style="{StaticResource BrandText}" Text="Run IAAO ratio studies and compare model runs side by side." />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Style="{StaticResource BrandCheck}" />
                            <TextBlock Style="{StaticResource BrandText}" Text="Track jobs, projects, tasks and reports with your office." />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Form. -->
        <StackPanel Grid.Column="1" Width="340" VerticalAlignment="Center">
            <TextBlock x:Name="Heading" Style="{StaticResource FormTitle}" Text="Welcome back" />
            <TextBlock x:Name="Subheading" Style="{StaticResource FormSubtitle}" Text="Sign in to your workspace." />

            <Border Style="{StaticResource SegmentTrackBorder}" HorizontalAlignment="Stretch" Margin="0,24,0,4">
                <UniformGrid Rows="1">
                    <RadioButton x:Name="SignInMode" GroupName="Mode" Content="Sign in" Style="{StaticResource SegmentButton}" IsChecked="True" Checked="ModeChanged" />
                    <RadioButton x:Name="CreateMode" GroupName="Mode" Content="Create account" Style="{StaticResource SegmentButton}" Checked="ModeChanged" Margin="4,0,0,0" />
                </UniformGrid>
            </Border>

            <StackPanel x:Name="NameSection" Visibility="Collapsed">
                <TextBlock Text="Full name" Style="{StaticResource FormLabel}" />
                <TextBox x:Name="NameBox" Style="{StaticResource Input}" Tag="Ada Lovelace" AutomationProperties.Name="Full name" />
            </StackPanel>

            <TextBlock Text="Email" Style="{StaticResource FormLabel}" />
            <TextBox x:Name="EmailBox" Style="{StaticResource Input}" Tag="you@office.gov" AutomationProperties.Name="Email" />

            <TextBlock Text="Password" Style="{StaticResource FormLabel}" />
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordInput}" AutomationProperties.Name="Password" />

            <TextBlock x:Name="ErrorLine" Style="{StaticResource ErrorText}" Margin="0,14,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="InfoLine" Style="{StaticResource InfoText}" Margin="0,14,0,0" Visibility="Collapsed" />

            <Button x:Name="SubmitButton" Style="{StaticResource WideButton}" Margin="0,22,0,0" IsDefault="True" Click="Submit">
                <TextBlock x:Name="SubmitText" Text="Sign in" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
