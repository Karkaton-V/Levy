<UserControl x:Class="Workbench.Desktop.CompareTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Workbench.Desktop">
    <!-- Compare tab: the last two runs side by side. Styles: Assets/Compare/CompareStyles.xaml. -->
    <Grid>
        <TextBlock Text="Change a rule on the Editor tab and press Run model. This tab then compares the last two runs."
                   Foreground="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding NoComparison, Converter={StaticResource BoolVis}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasComparison, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="32,20,20,40">
                <TextBlock Text="{Binding CompareTitle}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CompareSummary}" Foreground="{StaticResource Muted}" Margin="0,6,0,28" />

                <ItemsControl ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:StatTileView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Padding="24,20,24,24" Margin="0,8,12,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Spread of ratios across sold parcels" Style="{StaticResource CardTitle}" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Border Width="12" Height="12" Background="{StaticResource BeforeBar}" VerticalAlignment="Center" />
                                <TextBlock Text="Before" Foreground="{StaticResource Soft}" FontSize="12" Margin="8,0,24,0" />
                                <Border Width="12" Height="12" Background="{StaticResource AfterBar}" VerticalAlignment="Center" />
                                <TextBlock Text="After" Foreground="{StaticResource Soft}" FontSize="12" Margin="8,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Bins}" Height="180" Margin="0,28,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Bottom" ToolTip="{Binding Tip}" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border Width="26" Height="{Binding BeforeHeight}" Background="{StaticResource BeforeBar}" VerticalAlignment="Bottom" Margin="0,0,4,0" />
                                            <Border Width="26" Height="{Binding AfterHeight}" Background="{StaticResource AfterBar}" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource BinLabel}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Each label is the low end of a 0.05-wide bin. Bins inside the 0.95 to 1.05 target are labelled in bold."
                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,20,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0" Margin="0,20,12,0" ClipToBounds="True">
                    <StackPanel>
                        <TextBlock Text="Largest tax bill changes" Style="{StaticResource CardTitle}" Margin="24,18,24,14" />
                        <Grid Background="{StaticResource TableHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PARCEL" Style="{StaticResource TableHeader}" Margin="24,10" />
                            <TextBlock Grid.Column="1" Text="VALUE BEFORE" Style="{StaticResource TableHeader}" Margin="24,10" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="VALUE AFTER" Style="{StaticResource TableHeader}" Margin="24,10" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="TAX BEFORE" Style="{StaticResource TableHeader}" Margin="24,10" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="TAX AFTER" Style="{StaticResource TableHeader}" Margin="24,10" TextAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="CHANGE" Style="{StaticResource TableHeader}" Margin="24,10" TextAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TaxChanges}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="{StaticResource Link}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="24,14" />
                                            <TextBlock Grid.Column="1" Text="{Binding ValueBefore}" Foreground="{StaticResource Soft}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="24,14" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{Binding ValueAfter}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="24,14" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding TaxBefore}" Foreground="{StaticResource Soft}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="24,14" TextAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{Binding TaxAfter}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="24,14" TextAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="{Binding Change}" Foreground="{StaticResource WarnText}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="24,14" TextAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
