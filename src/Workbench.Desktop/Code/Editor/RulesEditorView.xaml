<UserControl x:Class="Workbench.Desktop.RulesEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit">
    <!-- Code editor for the rules: line numbers, syntax colours, live problem squiggles, Ctrl+Space completion, Ctrl+F find. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <avalon:TextEditor x:Name="Editor" Grid.Row="0"
                           FontFamily="{StaticResource Mono}" FontSize="14"
                           Background="Transparent" Foreground="{DynamicResource Text}"
                           ShowLineNumbers="True" LineNumbersForeground="{DynamicResource EditorLineNumbers}"
                           Padding="0,12,0,12"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />

        <Border Grid.Row="1" Background="{DynamicResource TableHead}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,9">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="CaretStatus" DockPanel.Dock="Left" Text="Ln 1, Col 1" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource Mono}" FontSize="12" />
                <TextBlock DockPanel.Dock="Left" Text="Edited · press F5 to run" Foreground="{DynamicResource WarnText}" FontSize="12" Margin="20,0,0,0"
                           Visibility="{Binding IsStale, Converter={StaticResource BoolVis}}" />
                <TextBlock DockPanel.Dock="Right" Text="Ctrl+Space rule names · Ctrl+F find · F5 run" Foreground="{DynamicResource Muted}" FontSize="12" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
