<UserControl x:Class="Workbench.Desktop.TeamPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Workbench.Desktop">
    <!-- Team (company admins): the company code, everyone who joined or asked to, and the review form. DataContext: WorkspaceViewModel. Styles: Assets/Workspace/WorkspaceStyles.xaml. -->
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <local:PageHeaderView Grid.ColumnSpan="2" DataContext="{Binding Team}" />

        <!-- The code new people type when they create an account; their request then waits here for review. -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CodeBanner}" Margin="0,16,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Copy code" Click="CopyCode_Click" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource CodeText}" Text="{Binding JoinCode}" DockPanel.Dock="Left" />
                <TextBlock Style="{StaticResource CodeHint}" Text="Company code: new people enter it when they create an account, and wait here until an admin approves them." />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource TableCard}" Margin="0,16,20,0">
            <Grid>
                <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Team.View}" SelectedItem="{Binding Team.Selected, Mode=TwoWay}" AutomationProperties.Name="Team">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Person" SortMemberPath="FullName" Width="*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CellStrong}" />
                                        <TextBlock Text="{Binding Email}" Style="{StaticResource CellMuted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Job title" Binding="{Binding Title}" SortMemberPath="JobTitle" Width="Auto" />
                        <DataGridTemplateColumn Header="Role" SortMemberPath="Role" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentPresenter Content="{Binding RoleChip}" ContentTemplate="{StaticResource ChipTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentPresenter Content="{Binding StatusChip}" ContentTemplate="{StaticResource ChipTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Style="{StaticResource AdminMessage}" Text="{Binding AdminMessage}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource FormCard}" Margin="0,16,0,0" DataContext="{Binding Team}">
            <Grid>
                <TextBlock Style="{StaticResource FormHint}" Text="Pick someone to review them, or press Add person to add an account that already exists." />
                <ScrollViewer Style="{StaticResource FormScroll}">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource CardTitle}" />

                        <!-- An existing person: who they are. A new one: the email they signed up with. -->
                        <StackPanel Visibility="{Binding Draft.IsExisting, Converter={StaticResource BoolVis}}" Margin="0,12,0,0">
                            <TextBlock Text="{Binding Draft.Name}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Draft.Email}" Style="{StaticResource CellMuted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding Draft.IsNewPerson, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Email" Style="{StaticResource FormLabel}" />
                            <TextBox Style="{StaticResource Input}" Text="{Binding Draft.Email}" Tag="name@example.com" AutomationProperties.Name="Email" />
                        </StackPanel>

                        <!-- A request to join: approve or decline in one click (the job title and role below are saved with it). -->
                        <Border Style="{StaticResource ReviewBox}" Visibility="{Binding Draft.IsPending, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Asked to join with the company code." Style="{StaticResource CellMuted}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Approve" Command="{Binding Workspace.ApproveCommand}" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Decline" Command="{Binding Workspace.RejectCommand}" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Job title" Style="{StaticResource FormLabel}" />
                        <TextBox Style="{StaticResource Input}" Text="{Binding Draft.JobTitle}" Tag="Residential appraiser" AutomationProperties.Name="Job title" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Role" Style="{StaticResource FormLabel}" />
                                <ComboBox Style="{StaticResource Select}" MinWidth="0" ItemsSource="{x:Static local:Choices.MemberRoles}" SelectedItem="{Binding Draft.RoleLabel}" AutomationProperties.Name="Role" />
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0" Visibility="{Binding Draft.IsExisting, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Access" Style="{StaticResource FormLabel}" />
                                <ComboBox Style="{StaticResource Select}" MinWidth="0" ItemsSource="{x:Static local:Choices.MemberStatuses}" SelectedItem="{Binding Draft.StatusLabel}" AutomationProperties.Name="Access" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Admins can review people, set job titles and see the company code." Style="{StaticResource FormNote}" />
                        <local:FormActionsView />

                        <!-- Badges: awarded by admins, shown on the person's profile card. -->
                        <StackPanel Visibility="{Binding Workspace.CanAwardBadges, Converter={StaticResource BoolVis}}">
                            <Border Style="{StaticResource FormDivider}" />
                            <TextBlock Text="Badges" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding Workspace.DraftBadges}" Margin="0,10,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Take back" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.Workspace.RevokeBadgeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <Border Style="{StaticResource BadgePill}" ToolTip="{Binding Tip}" Margin="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource BadgeGlyph}" />
                                                    <TextBlock Style="{StaticResource ChipText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No badges yet." Style="{StaticResource FormNote}" Margin="0,0,0,0"
                                       Visibility="{Binding Workspace.HasDraftBadges, Converter={StaticResource InverseBoolVis}}" />
                            <TextBlock Text="Award a badge" Style="{StaticResource FormLabel}" />
                            <ComboBox Style="{StaticResource Select}" ItemsSource="{x:Static local:BadgeInfo.Catalog}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding Workspace.AwardBadge}" AutomationProperties.Name="Badge" />
                            <TextBox Style="{StaticResource Input}" Text="{Binding Workspace.AwardReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                     Tag="What it's for (optional)" Margin="0,8,0,0" AutomationProperties.Name="Reason" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Award badge" Command="{Binding Workspace.AwardBadgeCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            <TextBlock Style="{StaticResource TeamResult}" Text="{Binding Workspace.TeamMessage}" />
                        </StackPanel>

                        <!-- Deleting an account: members only, never yourself; asks first. -->
                        <StackPanel Visibility="{Binding Workspace.CanDeleteDraft, Converter={StaticResource BoolVis}}">
                            <Border Style="{StaticResource FormDivider}" />
                            <TextBlock Text="Delete account" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Permanently deletes their sign-in and profile. Their jobs, tasks and records stay with the company, unassigned. This can't be undone."
                                       Style="{StaticResource FormNote}" />
                            <Button Style="{StaticResource DangerButton}" Content="Delete account…" Click="DeleteAccount_Click" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
