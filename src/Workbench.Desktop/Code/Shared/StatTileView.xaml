<UserControl x:Class="Workbench.Desktop.StatTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One ratio-study number with its target; shown on the Editor and Compare tabs. DataContext is a StatTile. -->
    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,12">
        <StackPanel>
            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}" FontSize="12" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Before}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Bottom" Margin="12,0,0,5" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource StatusPill}">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource PillText}" />
                </Border>
                <TextBlock Text="{Binding Target}" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
