<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Profile banner colours (Light theme): one gradient per banner choice (profiles.banner_color). The other theme's file has the same keys. -->
    <LinearGradientBrush x:Key="BannerBlue" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0" />
        <GradientStop Color="#60A5FA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BannerTeal" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D9488" Offset="0" />
        <GradientStop Color="#2DD4BF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BannerGreen" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#16A34A" Offset="0" />
        <GradientStop Color="#4ADE80" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BannerAmber" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D97706" Offset="0" />
        <GradientStop Color="#FBBF24" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BannerRose" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E11D48" Offset="0" />
        <GradientStop Color="#FB7185" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BannerPurple" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0" />
        <GradientStop Color="#A78BFA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BannerSlate" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#475569" Offset="0" />
        <GradientStop Color="#94A3B8" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
