<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Profile banner colours (Light theme): one gradient per banner choice (profiles.banner_color). The other theme's file has the same keys. -->
    <LinearGradientBrush x:Key="BannerBlue" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0" />
        <GradientStop Color="#60A5FA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BannerTeal" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D9488" Offset="0" />
        <GradientStop Color="#2DD4BF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BannerGreen" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#16A34A" Offset="0" />
        <GradientStop Color="#4ADE80" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BannerAmber" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D97706" Offset="0" />
        <GradientStop Color="#FBBF24" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BannerRose" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E11D48" Offset="0" />
        <GradientStop Color="#FB7185" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BannerPurple" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0" />
        <GradientStop Color="#A78BFA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BannerSlate" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#475569" Offset="0" />
        <GradientStop Color="#94A3B8" Offset="1" />
    </LinearGradientBrush>
    <!-- Behind a profile picture, so transparent parts show black rather than the initials colour. -->
    <SolidColorBrush x:Key="AvatarBackdropFill" Color="#000000" />
    <!-- The picture and banner cropper: the dimmed area outside the frame, and the frame and its corner handles. -->
    <SolidColorBrush x:Key="CropShadeFill" Color="#A6000000" />
    <SolidColorBrush x:Key="CropFrameLine" Color="#FFFFFF" />
    <!-- Profile colours: each person's choice (profiles.banner_color) becomes the app's accent, and the backgrounds take a slight tint of it.
         ThemeManager recolours the blue-tinted keys to this hue; Blue leaves the theme exactly as designed. -->
    <Color x:Key="ProfileBlue">#2563EB</Color>
    <Color x:Key="ProfileTeal">#0D9488</Color>
    <Color x:Key="ProfileGreen">#16A34A</Color>
    <Color x:Key="ProfileAmber">#D97706</Color>
    <Color x:Key="ProfileRose">#E11D48</Color>
    <Color x:Key="ProfilePurple">#7C3AED</Color>
    <Color x:Key="ProfileSlate">#475569</Color>
    <!-- Text on the accent where white would be hard to read. -->
    <Color x:Key="ProfileOnAmber">#1F1300</Color>
</ResourceDictionary>
