<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colours, fonts and styles used by more than one tab: a light workspace with white cards, like most practice and assessor apps. -->

    <!-- Workspace -->
    <SolidColorBrush x:Key="Ground" Color="#F3F5F8" />
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Line" Color="#E2E6EC" />
    <SolidColorBrush x:Key="TableHead" Color="#F7F8FA" />
    <SolidColorBrush x:Key="Text" Color="#1A2230" />
    <SolidColorBrush x:Key="Soft" Color="#3B4556" />
    <SolidColorBrush x:Key="Muted" Color="#6A7486" />
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Link" Color="#2563EB" />
    <SolidColorBrush x:Key="WarnText" Color="#B45309" />
    <SolidColorBrush x:Key="PassStatus" Color="#15803D" />
    <SolidColorBrush x:Key="PassFill" Color="#E6F4EA" />
    <SolidColorBrush x:Key="WarnStatus" Color="#C2410C" />
    <SolidColorBrush x:Key="WarnFill" Color="#FDEFE4" />
    <SolidColorBrush x:Key="HoverFill" Color="#EEF2F7" />
    <SolidColorBrush x:Key="HoverFillSoft" Color="#F5F7FA" />
    <SolidColorBrush x:Key="ControlBorder" Color="#CBD2DC" />

    <!-- Left navigation rail -->
    <SolidColorBrush x:Key="NavBackground" Color="#1C2433" />
    <SolidColorBrush x:Key="NavStrong" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavText" Color="#C6CEDA" />
    <SolidColorBrush x:Key="NavMuted" Color="#7E8A9E" />
    <SolidColorBrush x:Key="NavHover" Color="#263042" />
    <SolidColorBrush x:Key="NavSelected" Color="#2D3A52" />
    <SolidColorBrush x:Key="NavAccent" Color="#5B9BFF" />

    <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolVis" />

    <!-- Small uppercase label above a group, and the column headers of tables. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TableHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- White card with a hairline border: the building block of every page. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Green or orange text, from an IsPass property on the bound item. -->
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WarnStatus}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPass}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource PassStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Rounded status pill (pair with PillText inside), tinted green or orange from IsPass. -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarnFill}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPass}" Value="True">
                <Setter Property="Background" Value="{StaticResource PassFill}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Orange pill shown while the rules have been edited but not run. -->
    <Style x:Key="WarnPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarnFill}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource Accent}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" Padding="16,8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NavAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- White outlined button. -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource Panel}" BorderBrush="{StaticResource ControlBorder}" BorderThickness="1" CornerRadius="7" Padding="14,7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
