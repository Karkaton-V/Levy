<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The workflow pages (Jobs, Projects, Tasks, Clients, Reports): counters, toolbar, table card and edit form. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ValuationWorkbench;component/Assets/Shared/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- A Chip (Text, Tone) as a coloured pill. -->
    <DataTemplate x:Key="ChipTemplate">
        <Border Style="{StaticResource Chip}">
            <TextBlock Style="{StaticResource ChipText}" />
        </Border>
    </DataTemplate>

    <Style x:Key="PageCounters" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemTemplate" Value="{StaticResource SummaryCardTemplate}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CountText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

    <!-- The card around a table: no padding so the header runs edge to edge. -->
    <Style x:Key="TableCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- "Loading…" or a load error over a table; hidden once the rows are in (HasMessage on the workspace). -->
    <Style x:Key="TableMessage" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasMessage}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FormCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- The edit form shows while there is a draft (HasDraft on the page); the hint shows otherwise. -->
    <Style x:Key="FormScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="24,20" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasDraft}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FormHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="32" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasDraft}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Several lines of text, e.g. a description or summary. -->
    <Style x:Key="TextArea" TargetType="TextBox" BasedOn="{StaticResource Input}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="ProgressCell" TargetType="ProgressBar" BasedOn="{StaticResource Progress}">
        <Setter Property="Width" Value="64" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CellMuted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Soft}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CellStrong" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Admin pages (Team, Companies) -->

    <!-- Why the Team or Companies list couldn't load (HasAdminMessage on the workspace). -->
    <Style x:Key="AdminMessage" TargetType="TextBlock" BasedOn="{StaticResource TableMessage}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasMessage}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasAdminMessage}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Shown on the Activity page while the log is empty (and nothing went wrong loading it). -->
    <Style x:Key="EmptyActivity" TargetType="TextBlock" BasedOn="{StaticResource FormHint}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Activity.Items.Count}" Value="0" />
                    <Condition Binding="{Binding HasAdminMessage}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The strip on the Team page showing the company code. -->
    <Style x:Key="CodeBanner" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="20,12" />
    </Style>

    <Style x:Key="CodeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Link}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,20,0" />
    </Style>

    <Style x:Key="CodeHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

    <!-- The approve / decline box on a pending person. -->
    <Style x:Key="ReviewBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ToneAmberFill}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,16,0,0" />
    </Style>

    <Style x:Key="FormNote" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <Style x:Key="FormCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Margin" Value="0,14,0,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="FormDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Line}" />
        <Setter Property="Margin" Value="0,24,0,20" />
    </Style>

    <!-- Read-only text in a form (a filed request's details). -->
    <Style x:Key="DetailText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <!-- The outcome of a GitLab action on the Intake page: muted when it worked, red when it didn't (IntakeFailed). -->
    <Style x:Key="IntakeResult" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IntakeFailed}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ToneRedText}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The outcome of a badge award on the Team page: green when it worked, red when it didn't (TeamFailed). -->
    <Style x:Key="TeamResult" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ToneGreenText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Workspace.TeamFailed}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ToneRedText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Workspace.HasTeamMessage}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The outcome of "Add to company": green when it worked, red when it didn't (AssignFailed). -->
    <Style x:Key="AssignResult" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ToneGreenText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,14,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding AssignFailed}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ToneRedText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasAssignMessage}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
