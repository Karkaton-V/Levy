<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Chart colours (light theme). Swapped at runtime by ThemeManager; the other theme's file has the same keys. -->
    <SolidColorBrush x:Key="BeforeBar" Color="#C3CAD5" />
    <SolidColorBrush x:Key="AfterBar" Color="#2563EB" />
    <SolidColorBrush x:Key="InTargetLabel" Color="#1A2230" />
</ResourceDictionary>
