<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Compare tab: before and after bar colours and bin labels. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ValuationWorkbench;component/Assets/Shared/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="BeforeBar" Color="#C3CAD5" />
    <SolidColorBrush x:Key="AfterBar" Color="#2563EB" />
    <SolidColorBrush x:Key="InTargetLabel" Color="#1A2230" />

    <!-- Bin labels are dark and bold inside the 0.95 to 1.05 target, muted outside it. -->
    <Style x:Key="BinLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="11" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding InTarget}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource InTargetLabel}" />
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
