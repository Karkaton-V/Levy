<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Navigation rail colours (light theme). Swapped at runtime by ThemeManager; the other theme's file has the same keys. -->
    <SolidColorBrush x:Key="NavBackground" Color="#1C2433" />
    <SolidColorBrush x:Key="NavStrong" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavText" Color="#C6CEDA" />
    <SolidColorBrush x:Key="NavMuted" Color="#7E8A9E" />
    <SolidColorBrush x:Key="NavHover" Color="#263042" />
    <SolidColorBrush x:Key="NavSelected" Color="#2D3A52" />
    <SolidColorBrush x:Key="NavAccent" Color="#5B9BFF" />
    <SolidColorBrush x:Key="NavLine" Color="#263042" />
    <!-- The Levy mark: the same in both themes. -->
    <SolidColorBrush x:Key="BrandWave" Color="#4F8DF7" />
    <SolidColorBrush x:Key="BrandMark" Color="#FFFFFF" />
    <!-- The Edit pill on the profile card banner: the same in both themes, since it sits on the banner. -->
    <SolidColorBrush x:Key="BannerButtonFill" Color="#73000000" />
    <SolidColorBrush x:Key="BannerButtonHover" Color="#A6000000" />
    <SolidColorBrush x:Key="BannerButtonText" Color="#FFFFFF" />
    <Color x:Key="MenuShadowColor">#1C2433</Color>
</ResourceDictionary>
