                                <Path.Data>
                                    <GeometryGroup>
                                        <EllipseGeometry Center="96,55" RadiusX="3.5" RadiusY="3.5" />
                                        <EllipseGeometry Center="85,50" RadiusX="2.5" RadiusY="2.5" />
                                        <EllipseGeometry Center="106,47" RadiusX="2" RadiusY="2" />
