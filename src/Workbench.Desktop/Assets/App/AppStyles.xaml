<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- The window shell: left navigation rail, top bar, summary cards and the page area. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ValuationWorkbench;component/Assets/Shared/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Segoe Fluent / MDL2 icons for the navigation and the Run button. -->
    <sys:String x:Key="EditorGlyph">&#xE943;</sys:String>
    <sys:String x:Key="MapGlyph">&#xE707;</sys:String>
    <sys:String x:Key="CompareGlyph">&#xE9D2;</sys:String>
    <sys:String x:Key="RunGlyph">&#xE768;</sys:String>

    <!-- The Levy mark (docs/brand/levy-icon.svg): a levee L taking a breaking wave, on a rounded blue tile. Set Width and Height; it scales. -->
    <Style x:Key="LevyMark" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox>
                        <Canvas Width="256" Height="256">
                            <Canvas.Clip>
                                <RectangleGeometry Rect="0,0,256,256" RadiusX="56" RadiusY="56" />
                            </Canvas.Clip>
                            <Rectangle Width="256" Height="256" Fill="{DynamicResource BrandTile}" />
                            <Path Fill="{DynamicResource BrandMark}" Opacity="0.5"
                                  Data="M20,200 C30,160 54,122 86,106 C104,97 120,95 130,101 L114,106 C102,108 94,118 92,132 C90,150 92,174 94.5,188 L92,200 Z" />
                            <Path Fill="{DynamicResource BrandMark}" Opacity="0.6">
                                <Path.Data>
                                    <GeometryGroup>
                                        <EllipseGeometry Center="124,82" RadiusX="4.5" RadiusY="4.5" />
                                        <EllipseGeometry Center="110,76" RadiusX="3.5" RadiusY="3.5" />
                                        <EllipseGeometry Center="134,72" RadiusX="3" RadiusY="3" />
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>
                            <Path Fill="{DynamicResource BrandMark}" Data="M92,200 L124,62 L158,62 L158,168 L222,168 L222,200 Z" />
                            <Rectangle Canvas.Top="200" Width="256" Height="56" Fill="{DynamicResource BrandTileShade}" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The navigation list: no chrome of its own, the items do the drawing. -->
    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- One navigation entry. Tag holds its icon glyph; a blue bar marks the open page. -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource NavText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="12,2">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Glyph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}"
                                           FontSize="16" Foreground="{DynamicResource NavMuted}" VerticalAlignment="Center" />
                                <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="Bar" Width="3" CornerRadius="2" Margin="0,9" HorizontalAlignment="Left" Background="{DynamicResource NavAccent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelected}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource NavAccent}" />
                            <Setter Property="Foreground" Value="{DynamicResource NavStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NavAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The page area: shows the selected page only; the navigation rail does the switching.
         The tab strip is kept but hidden at zero height: without an items host the TabControl never selects or shows a page. -->
    <Style x:Key="PageTabs" TargetType="TabControl">
        <!-- WPF's built-in tab style sets black text; pages inherit the theme's text colour instead. -->
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <TabPanel IsItemsHost="True" Height="0" Visibility="Hidden" />
                        <ContentPresenter ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Account footer at the bottom of the rail, and the settings menu that opens upward from it. -->
    <sys:String x:Key="SettingsGlyph">&#xE713;</sys:String>
    <sys:String x:Key="SignOutGlyph">&#xF3B1;</sys:String>

    <Style x:Key="RailFooter" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource NavLine}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="20,14,14,14" />
    </Style>

    <!-- Round badge with the user's initials. -->
    <Style x:Key="Avatar" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>

    <Style x:Key="AvatarText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The gear: an icon toggle drawn in the rail's colours. -->
    <Style x:Key="RailIconToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource NavMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource NavStrong}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelected}" />
                            <Setter Property="Foreground" Value="{DynamicResource NavAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NavAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The popup's card: a Card with a soft shadow, as wide as the rail less an equal 12px gap each side. -->
    <Style x:Key="MenuCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16,20" />
        <Setter Property="Margin" Value="12,12,12,8" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource MenuShadowColor}" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.28" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Line}" />
        <Setter Property="Margin" Value="0,14" />
    </Style>

    <!-- Summary strip under the top bar: hidden while the full-size map is open. -->
    <Style x:Key="SummaryStrip" TargetType="ItemsControl">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMapExpanded}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- White bar across the top of every page. -->
    <Style x:Key="TopBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="32,16" />
    </Style>

</ResourceDictionary>
