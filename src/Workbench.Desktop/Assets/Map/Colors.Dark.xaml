<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Map overlay and control colours (dark theme). Swapped at runtime by ThemeManager; the other theme's file has the same keys. -->
    <SolidColorBrush x:Key="MapOverlay" Color="#F20B0E13" />
    <SolidColorBrush x:Key="MapOverlaySoft" Color="#E60B0E13" />
    <SolidColorBrush x:Key="MapOverlayText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MapControlFill" Color="#171B22" />
    <SolidColorBrush x:Key="MapControlFillHover" Color="#222833" />
    <SolidColorBrush x:Key="MapControlBorder" Color="#363E4B" />
    <SolidColorBrush x:Key="MapControlFocus" Color="#3B82F6" />
    <SolidColorBrush x:Key="MapControlText" Color="#E6E9EF" />
    <SolidColorBrush x:Key="MapControlPlaceholder" Color="#8A93A3" />
</ResourceDictionary>
