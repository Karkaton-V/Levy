<?xml version="1.0" encoding="utf-8"?>
<!-- The Paper code theme's syntax colours for the rules language; its editor colours are CodePaper* in Assets/Editor/Colors.*.xaml. -->
<SyntaxDefinition name="Rules" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#8A8275" fontStyle="italic" />
  <Color name="Key" foreground="#2F5D8A" />
  <Color name="Neighborhood" foreground="#8A3B7A" />
  <Color name="Number" foreground="#A6531B" />
  <Color name="Operator" foreground="#6B6459" />
  <RuleSet>
    <Span color="Comment"><Begin>\#</Begin></Span>
    <Rule color="Neighborhood">(?&lt;=\.)[A-Za-z0-9\-]+(?=\s*=)</Rule>
    <Rule color="Key">[A-Za-z][A-Za-z0-9]*(?=\s*[.=])</Rule>
    <Rule color="Operator">=</Rule>
    <Rule color="Number">-?[0-9]+(\.[0-9]+)?</Rule>
  </RuleSet>
</SyntaxDefinition>
