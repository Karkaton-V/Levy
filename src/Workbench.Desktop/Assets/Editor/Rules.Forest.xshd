<?xml version="1.0" encoding="utf-8"?>
<!-- The Forest code theme's syntax colours for the rules language; its editor colours are CodeForest* in Assets/Editor/Colors.*.xaml. -->
<SyntaxDefinition name="Rules" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6F8C78" fontStyle="italic" />
  <Color name="Key" foreground="#7FD1A0" />
  <Color name="Neighborhood" foreground="#B5D99C" />
  <Color name="Number" foreground="#E9C46A" />
  <Color name="Operator" foreground="#9DB8A6" />
  <RuleSet>
    <Span color="Comment"><Begin>\#</Begin></Span>
    <Rule color="Neighborhood">(?&lt;=\.)[A-Za-z0-9\-]+(?=\s*=)</Rule>
    <Rule color="Key">[A-Za-z][A-Za-z0-9]*(?=\s*[.=])</Rule>
    <Rule color="Operator">=</Rule>
    <Rule color="Number">-?[0-9]+(\.[0-9]+)?</Rule>
  </RuleSet>
</SyntaxDefinition>
