<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Code editor colours (light theme). Swapped at runtime by ThemeManager; the other theme's file has the same keys. -->
    <SolidColorBrush x:Key="EditorLineNumbers" Color="#A3ACBA" />
    <SolidColorBrush x:Key="EditorCurrentLine" Color="#F3F6FB" />
    <Pen x:Key="EditorCurrentLineBorder" Brush="Transparent" Thickness="0" />
    <SolidColorBrush x:Key="EditorSelection" Color="#332563EB" />
    <SolidColorBrush x:Key="EditorCaret" Color="#1A2230" />
    <SolidColorBrush x:Key="EditorProblemTint" Color="#16F59E0B" />
    <Pen x:Key="EditorProblemSquiggle" Brush="#D97706" Thickness="1.2" />
</ResourceDictionary>
