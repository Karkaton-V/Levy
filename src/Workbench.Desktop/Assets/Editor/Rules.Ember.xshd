<?xml version="1.0" encoding="utf-8"?>
<!-- The Ember code theme's syntax colours for the rules language; its editor colours are CodeEmber* in Assets/Editor/Colors.*.xaml. -->
<SyntaxDefinition name="Rules" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#8C7A68" fontStyle="italic" />
  <Color name="Key" foreground="#F2A65A" />
  <Color name="Neighborhood" foreground="#E07A5F" />
  <Color name="Number" foreground="#F2CC8F" />
  <Color name="Operator" foreground="#C9B79C" />
  <RuleSet>
    <Span color="Comment"><Begin>\#</Begin></Span>
    <Rule color="Neighborhood">(?&lt;=\.)[A-Za-z0-9\-]+(?=\s*=)</Rule>
    <Rule color="Key">[A-Za-z][A-Za-z0-9]*(?=\s*[.=])</Rule>
    <Rule color="Operator">=</Rule>
    <Rule color="Number">-?[0-9]+(\.[0-9]+)?</Rule>
  </RuleSet>
</SyntaxDefinition>
